# Generate a unique 32+ character secret before production use.
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
# This address is used by the browser, not by the Docker network.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Keep this value private. It is read by the server only.
ANTHROPIC_API_KEY=
# Postgres connection string. When running via `docker-compose up`, the
# compose file overrides this to use the in-network "postgres" hostname;
# this value is for running the server directly on the host.
DATABASE_URL=postgresql://uno:uno@localhost:5432/uno?schema=public
