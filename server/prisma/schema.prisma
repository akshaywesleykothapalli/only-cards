datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String?        // Nullable for Guest/OAuth profiles
  provider     String         // "GUEST" | "GOOGLE" | "DISCORD" | "PASSWORD"
  createdAt    DateTime       @default(now())
  profile      Profile?
  matches      MatchHistory[]
  friendships  Friendship[] @relation("UserFriendships")
  feedback     Feedback[]
}

enum FeedbackCategory {
  BUG_GLITCH
  GAMEPLAY_ISSUE
  UI_MOBILE_ISSUE
  FEATURE_SUGGESTION
  GENERAL_FEEDBACK
}

enum FeedbackStatus {
  NEW
  INVESTIGATING
  PLANNED
  RESOLVED
  CLOSED
}

model Feedback {
  id             String           @id @default(uuid())
  category       FeedbackCategory
  status         FeedbackStatus   @default(NEW)
  rating         Int?
  message        String
  page           String?
  appVersion     String?
  userAgent      String?
  browser        String?
  os             String?
  viewportWidth  Int?
  viewportHeight Int?
  roomId         String?
  gameContext    Json?
  userId         String?
  username       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([category])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(uuid())
  userId      String
  friendId    String
  status      String   @default("PENDING") // "PENDING" | "ACCEPTED" | "BLOCKED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar      String   @default("default_avatar")
  banner      String   @default("default_banner")
  xp          Int      @default(0)
  level       Int      @default(1)
  mmr         Int      @default(1000)
  rankedTier  String   @default("BRONZE_I")
  gamesPlayed Int      @default(0)
  gamesWon    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([mmr])
}

model MatchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  won       Boolean  @default(false)
  score     Int      @default(0)
  rank      Int      @default(1) // placement rank in the room: 1st, 2nd, etc.
  playedAt  DateTime @default(now())

  @@index([userId])
}

model ReplayLog {
  id        String   @id @default(uuid())
  roomId    String
  logData   String   // Stores complete JSON string of ReplayFrame[]
  playedAt  DateTime @default(now())
}
